<?xml version="1.0"?>
<robot name="ur5e_workcell">
  <group name="ur_manipulator"><chain base_link="base_link" tip_link="tcp"/></group>
  <group name="gripper"><joint name="robotiq_85_left_knuckle_joint"/></group>
  <end_effector name="robotiq" parent_link="tool0" group="gripper" parent_group="ur_manipulator"/>
  <group_state name="home" group="ur_manipulator">
    <joint name="shoulder_pan_joint" value="0"/>
    <joint name="shoulder_lift_joint" value="-1.570796327"/>
    <joint name="elbow_joint" value="1.570796327"/>
    <joint name="wrist_1_joint" value="-1.570796327"/>
    <joint name="wrist_2_joint" value="-1.570796327"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>
  <!-- Adjacent pairs are appended from the expanded URDF at launch. -->
  <disable_collisions link1="base_link_inertia" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="forearm_link" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never"/>
</robot>
